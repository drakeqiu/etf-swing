#!/bin/sh
set -eu

message_file=$1
subject=$(sed -n '1p' "$message_file")

case $subject in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*)
    exit 0
    ;;
esac

if printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?!?: .+'; then
  exit 0
fi

printf '%s\n' \
  '提交说明格式错误。使用 type(scope): subject，scope 可省略。' \
  '可用 type：feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert。' >&2
exit 1
